---
// 頁面載入時要不要一開始就是深色模式，是 BaseLayout.astro 的 is:inline
// script 決定的（讀 localStorage，避免閃屏）；這裡只負責「點擊之後」的切換，
// 並把選擇寫回 localStorage，讓下次載入時那段 is:inline script 讀得到。
---

<button
  id="theme-toggle"
  type="button"
  aria-label="切換深色模式"
  class="rounded-full p-2 text-muted transition-colors duration-200 hover:bg-card hover:text-foreground"
>
  {/* 兩個圖示都畫出來，用 dark:block／dark:hidden 切換誰看得見，
      而不是用 JS 動態換 icon——純 CSS 切換，沒有閃爍或延遲的問題。 */}
  <svg
    id="theme-toggle-icon-dark"
    class="hidden h-5 w-5 dark:block"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
  <svg
    id="theme-toggle-icon-light"
    class="block h-5 w-5 dark:hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
</button>

{/*
  以按鈕為圓心、擴散切換深淺模式，用瀏覽器原生的 View Transitions API
  （document.startViewTransition）。瀏覽器會先把切換前的畫面拍一張快照，
  等 DOM／class 都換好之後，再讓我們用 clip-path 畫一個從按鈕位置往外
  擴散的圓，把新畫面「揭露」出來——效果全靠瀏覽器合成，不用截圖、
  不用真的畫兩份 DOM。
  沒有支援這個 API 的瀏覽器（或使用者開了「減少動態效果」）會直接走
  else 分支，退回原本瞬間切換，不會壞掉、也不會噴錯誤。
*/}
<script>
  const btn = document.getElementById('theme-toggle');

  function applyTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    return isDark;
  }

  btn?.addEventListener('click', (event) => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!document.startViewTransition || prefersReducedMotion) {
      applyTheme();
      return;
    }

    // 圓心＝點擊座標；半徑＝圓心到畫面四個角最遠的那個距離，
    // 確保圓一路擴散到底時剛好蓋滿整個視窗，不會留下沒切換到的死角。
    const x = event.clientX;
    const y = event.clientY;
    const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    const wasDark = document.documentElement.classList.contains('dark');
    const transition = document.startViewTransition(() => applyTheme());

    transition.ready.then(() => {
      const clipPath = [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`];
      document.documentElement.animate(
        { clipPath: wasDark ? [...clipPath].reverse() : clipPath },
        {
          duration: 500,
          easing: 'ease-in-out',
          // 切成深色：讓「新畫面」從圓心擴散蓋過去；切回淺色則反過來，
          // 讓「舊畫面」從圓心往內收合，露出底下的新畫面。
          pseudoElement: wasDark ? '::view-transition-old(root)' : '::view-transition-new(root)',
        }
      );
    });
  });
</script>
