---
// 頁面載入時要不要一開始就是深色模式，是 BaseLayout.astro 的 is:inline
// script 決定的（讀 localStorage，避免閃屏）；這裡只負責「點擊之後」的切換，
// 並把選擇寫回 localStorage，讓下次載入時那段 is:inline script 讀得到。
---

<button
  id="theme-toggle"
  type="button"
  aria-label="切換深色模式"
  class="rounded-full p-2 text-muted transition-colors duration-200 hover:bg-card hover:text-foreground"
>
  {/* 兩個圖示都畫出來，用 dark:block／dark:hidden 切換誰看得見，
      而不是用 JS 動態換 icon——純 CSS 切換，沒有閃爍或延遲的問題。 */}
  <svg
    id="theme-toggle-icon-dark"
    class="hidden h-5 w-5 dark:block"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
  <svg
    id="theme-toggle-icon-light"
    class="block h-5 w-5 dark:hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
