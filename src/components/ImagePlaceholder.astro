---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = '案場照片待補' } = Astro.props;
---

<div
  class={`flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-border bg-card-hover text-muted ${className}`}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6 opacity-60">
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <circle cx="9" cy="10.5" r="1.75"></circle>
    <path d="M3 16.5l5-4.5 4 3.5 3-3 6 5"></path>
  </svg>
  <span class="text-xs">{label}</span>
</div>
