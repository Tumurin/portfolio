---
// 這張卡片同時給 /blog 跟 /portfolio 兩份列表頁共用。
// blog 的內容集合沒有圖片欄位，所以圖片區塊預設不顯示（imageSlot=false）；
// portfolio/index.astro 呼叫這個元件時會另外傳 imageSlot + image，
// 才會多顯示一塊「有圖就顯示真圖、沒圖就顯示待補版位」的區域。
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  image?: string;
  imageSlot?: boolean;
}

const { href, title, description, date, tags = [], image, imageSlot = false } = Astro.props;
---

{/* data-reveal：捲動到這張卡片才淡入，機制寫在 BaseLayout.astro 底部的
    IntersectionObserver script 裡。 */}
<a
  href={href}
  data-reveal
  class="group block rounded-xl border border-border bg-card p-6 transition-colors duration-200 hover:border-accent"
>
  {imageSlot && (
    image ? (
      <img src={image} alt="" class="mb-4 h-36 w-full rounded-lg object-cover" />
    ) : (
      <ImagePlaceholder class="mb-4 h-36 w-full" />
    )
  )}
  <h2 class="text-lg font-semibold text-foreground transition-colors duration-200 group-hover:text-accent">
    {title}
  </h2>
  {date && (
    <p class="mt-1 text-xs text-muted">
      {date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
  )}
  <p class="mt-2 text-sm text-muted">{description}</p>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="tag-chip rounded-full px-2 py-0.5 text-xs font-medium">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
