---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/portfolio', label: '作品集' },
  { href: '/blog', label: '文章' },
  { href: '/about', label: '關於我' },
];
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="font-semibold text-slate-900 dark:text-slate-100">我的名字</a>
    <nav class="flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-slate-600 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
        >
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>
