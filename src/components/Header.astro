---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/portfolio', label: '作品集' },
  { href: '/blog', label: '文章' },
  { href: '/about', label: '關於我' },
];
---

<header class="sticky top-0 z-10 border-b border-border bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-bold tracking-tight text-foreground">
      寬<span class="text-accent">.</span>
    </a>
    <nav class="flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-muted transition-colors duration-200 hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>
