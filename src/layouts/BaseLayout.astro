---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/wght.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '個人作品集與部落格' } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/*
      is:inline 讓 Astro 原封不動輸出這段 <script>，不搬去 bundle、不延後執行。
      它必須在瀏覽器畫出第一個像素「之前」跑完，先幫 <html> 加上 .dark class，
      不然會先看到亮色版畫面、CSS 載完才突然跳成暗色（閃屏）。
      讀取順序：使用者上次手動選的顏色（localStorage）優先於系統設定。
    */}
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16">
      <slot />
    </main>
    <Footer />
    {/*
      這段只負責「捲動到才播放」的效果，目標是 [data-reveal]（例如
      Card.astro 的列表卡片，單純淡入＋上移）跟 [data-timeline]
      （首頁流程時間軸，畫線＋文字依序淡入，效果定義在 global.css）。
      兩種元素都只是加一個 .is-visible class，剩下的動畫細節各自寫在
      對應的 CSS 規則裡，這顆觀察器不用知道兩者動畫長什麼樣子。
      ⚠️ 首頁英雄圖的滑入面板（.slide-in-left）不會被這裡選到——它是
      一進站就看得到的區塊（above the fold），改用 global.css 裡單純的
      CSS @keyframes 讓它一載入就播放。曾經試過也讓它套用這裡的
      IntersectionObserver，但面板進場動畫會先把自己推到畫面外，
      導致觀察器永遠偵測不到它「進入畫面」而卡死不動——這是實測踩過的坑，
      所以這兩種進場動畫刻意分成兩條不同的路。
      rootMargin 的 -40px 讓卡片要多滑進來一點才觸發，不會一露出邊緣就跳出來。
    */}
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal], [data-timeline]');
      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
