---
// 一頁式履歷。所有內容來自 src/content/about/about.md 這一個檔——
// 要改履歷改那裡，不要改這頁的排版程式碼。
//
// 🔴 這頁刻意不含姓名、Email、電話、居住城市。聯絡方式只有 LINE 與 GitHub。
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import RepoMarquee from '../components/RepoMarquee.astro';

const [profile] = await getCollection('about');
const { Content } = await render(profile);
const me = profile.data;

// order 小的排前面。排序在這裡做而不是在跑馬燈元件裡，元件只負責「排一橫排
// 並決定要不要捲」，不該知道內容是怎麼來的。
const repos = (await getCollection('repos'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((repo) => ({
    slug: repo.id,
    title: repo.data.title,
    description: repo.data.description,
    coverImage: repo.data.coverImage,
  }));
---

<BaseLayout title="關於我 — 昱感網頁美學" description={me.summary}>
  {/* ① 自我介紹＋大頭照 */}
  <section class="grid gap-12 md:grid-cols-[1.4fr_1fr] md:items-center">
    <div>
      <p class="text-sm font-medium tracking-wide text-accent">關於我</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        {me.heading}
      </h1>

      {/* whitespace-pre-line：段落內的換行照 about.md 裡寫的呈現，
          內容那邊就不必摻 <br> 這種排版標記。 */}
      <div class="mt-8 space-y-5">
        {me.intro.map((paragraph) => (
          <p class="leading-relaxed whitespace-pre-line text-foreground">{paragraph}</p>
        ))}
      </div>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={me.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-foreground transition-opacity duration-200 hover:opacity-90"
        >
          用 LINE 聯絡我
        </a>
        <a
          href={me.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>
    </div>

    {/* 大頭照還沒提供，先用跟作品集案例同一個「待補」版位，換成
        aspect-[4/5] 的直式比例。之後在 about.md 填 photo 就自動換成真圖。 */}
    <div>
      {me.photo ? (
        <img src={me.photo} alt="" class="aspect-[4/5] w-full rounded-xl object-cover" />
      ) : (
        <ImagePlaceholder class="aspect-[4/5] w-full" label="大頭照待補" />
      )}
    </div>
  </section>

  {/* ② 專案卡片 */}
  <section class="mt-24">
    <p class="text-sm font-medium tracking-wide text-accent">01 — PROJECTS</p>
    <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">專案</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
      點進去看每一個是什麼、怎麼做的。放不下的卡片會自己滾動出現，滑鼠移上去或手指碰到就會停。
    </p>
    <div class="mt-8">
      <RepoMarquee repos={repos} />
    </div>
  </section>

  {/* ③ 學歷 · 技能 · 其他 */}
  <section class="mt-24">
    <p class="text-sm font-medium tracking-wide text-accent">02 — BACKGROUND</p>
    <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">學歷 · 技能</h2>

    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <h3 class="text-xs font-semibold tracking-widest text-muted uppercase">Education</h3>
        <ul class="mt-4 space-y-5">
          {me.education.map((item) => (
            <li>
              <p class="text-sm font-semibold text-foreground">{item.school}</p>
              {item.program && <p class="mt-0.5 text-sm text-muted">{item.program}</p>}
              <p class="mt-1 text-xs text-muted">{item.period}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-widest text-muted uppercase">Skills</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {me.skills.map((skill) => (
            <span class="tag-chip rounded-full px-2.5 py-1 text-xs font-medium">{skill}</span>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-widest text-muted uppercase">Others</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {me.others.map((skill) => (
            <span class="tag-chip rounded-full px-2.5 py-1 text-xs font-medium">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ④ 履歷時間軸 */}
  <section class="mt-24">
    <p class="text-sm font-medium tracking-wide text-accent">03 — EXPERIENCE</p>
    <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">履歷</h2>

    <ol class="mt-10 space-y-12 border-l border-border pl-6 sm:pl-8">
      {me.experience.map((job) => (
        <li data-reveal class="relative">
          {/* 圓點要壓在左邊那條線上：線在 <ol> 的左緣，所以圓點往左挪
              一個半徑再減掉線寬的一半。 */}
          <span
            class="absolute top-2 -left-[27px] h-2.5 w-2.5 rounded-full bg-accent sm:-left-[35px]"
            aria-hidden="true"></span>
          <p class="text-xs font-medium tracking-wide text-accent">{job.period}</p>
          <h3 class="mt-1.5 text-lg font-semibold text-foreground">{job.org}</h3>
          {job.role && <p class="mt-0.5 text-sm text-muted">{job.role}</p>}
          {job.highlights.length > 0 && (
            <ul class="mt-4 space-y-2">
              {job.highlights.map((point) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                  <span class="mt-px text-accent" aria-hidden="true">+</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  {/* ⑤ 自傳 */}
  <section class="mt-24">
    <p class="text-sm font-medium tracking-wide text-accent">04 — ABOUT ME</p>
    <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">自傳</h2>
    <div class="prose prose-neutral mt-8 max-w-none dark:prose-invert prose-a:text-accent">
      <Content />
    </div>
  </section>
</BaseLayout>
