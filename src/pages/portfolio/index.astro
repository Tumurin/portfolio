---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const items = (await getCollection('portfolio')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="作品集 — 我的名字">
  <p class="text-sm font-medium tracking-wide text-accent">作品集</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-foreground">精選作品</h1>
  <div class="mt-10 flex flex-col gap-4">
    {items.map((item) => (
      <Card
        href={`/portfolio/${item.id}`}
        title={item.data.title}
        description={item.data.description}
        date={item.data.date}
        tags={item.data.tags}
      />
    ))}
  </div>
</BaseLayout>
