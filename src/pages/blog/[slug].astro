---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — 昱感網頁美學`} description={post.data.description}>
  <article>
    <a href="/blog" class="text-sm font-medium text-accent transition-opacity hover:opacity-80">← 回文章列表</a>
    <h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{post.data.title}</h1>
    <p class="mt-2 text-sm text-muted">
      {post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert prose-a:text-accent">
      <Content />
    </div>
  </article>
</BaseLayout>
