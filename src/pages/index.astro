---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cloud from '../components/Cloud.astro';
---

<BaseLayout title="昱感網頁美學 — 軟體工程師">
  <section class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-border shadow-sm sm:aspect-[16/9]">
    <img
      src="/images/hero-day.webp"
      alt="剪紙風格的台北城市插畫，彩虹跨過台北101"
      class="absolute inset-0 h-full w-full object-cover object-left dark:hidden"
    />
    <img
      src="/images/hero-night.webp"
      alt="剪紙風格的台北城市夜景插畫，滿月高掛台北101上方"
      class="absolute inset-0 hidden h-full w-full object-cover object-left dark:block"
    />

    <Cloud
      class="absolute top-[6%] left-[46%] w-16 sm:w-24"
      style="--cloud-from-x:-28px; --cloud-from-y:-14px; --cloud-delay:80ms;"
    />
    <Cloud
      class="absolute top-[18%] left-[68%] w-20 sm:w-28"
      style="--cloud-from-x:30px; --cloud-from-y:-10px; --cloud-delay:280ms;"
    />
    <Cloud
      class="absolute top-[8%] right-[4%] w-24 sm:w-32"
      style="--cloud-from-x:40px; --cloud-from-y:-14px; --cloud-delay:460ms;"
    />

    <div
      class="slide-in-left absolute inset-y-0 left-0 z-10 flex w-full max-w-[15rem] flex-col justify-center gap-4 border-r border-border bg-card/95 p-6 backdrop-blur-sm sm:max-w-sm sm:p-10"
    >
      <p class="text-sm font-medium tracking-wide text-accent">軟體工程師</p>
      <h1 class="font-serif text-3xl leading-tight font-semibold text-foreground sm:text-4xl">
        你好，我是昱感網頁美學
      </h1>
      <p class="text-sm text-muted sm:text-base">
        2026 年，AI 能在三分鐘生出一個網站。我選擇不那麼快——花時間走進你的現場，把說不出口的需求聽懂。
      </p>
      <div class="flex gap-3 pt-2">
        <a
          href="/portfolio"
          class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground transition-opacity hover:opacity-90"
        >
          看作品集
        </a>
        <a
          href="/blog"
          class="rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-accent"
        >
          看文章
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
