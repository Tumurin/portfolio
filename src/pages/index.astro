---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="我的名字 — 軟體工程師">
  <p data-reveal class="text-sm font-medium tracking-wide text-accent">軟體工程師</p>
  <h1 data-reveal class="mt-3 text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl md:text-6xl">
    你好，我是我的名字
  </h1>
  <p data-reveal class="mt-6 max-w-xl text-lg text-muted">
    軟體工程師。這裡放我的作品與技術文章。
  </p>
  <div data-reveal class="mt-10 flex gap-4">
    <a
      href="/portfolio"
      class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition-colors duration-200 hover:opacity-90"
    >
      看作品集
    </a>
    <a
      href="/blog"
      class="rounded-md border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors duration-200 hover:border-accent"
    >
      看文章
    </a>
  </div>
</BaseLayout>
