---
// 首頁＝接案落地頁，由上到下：英雄圖 → 服務對象跑馬燈 → 四項服務 →
// 為什麼選我 → 五步驟流程 → 精選案例（動態抓作品集最新 3 篇）→ 結尾 CTA。
// 版面骨架深度參考 pluszero.tw，細節記在筆記庫的架構文件裡。
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cloud from '../components/Cloud.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

// 精選案例不寫死要顯示哪幾篇，改成「作品集裡日期最新的 3 篇」——
// 之後新增案例會自動輪替上首頁，不用回來改這支檔案。
const allCases = await getCollection('portfolio');
const cases = allCases.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const clientTypes = ['傳產升級', '獨立品牌', '手作工作室', '餐飲品牌', '文創商品', '社區形象', '個人品牌'];

const services = [
  {
    n: '01',
    tag: 'SERVICE.VISIT',
    title: '一頁式網頁設計',
    desc: '專為小型工作室、個人接案者，設計符合您產品的個性化網頁製作。',
    bullets: ['現場觀察與需求了解', '個性化製作符合產品定位', '特殊動畫效果另外計價'],
    price: 'NT$ 5,000',
    priceNote: '接案網市價 1–5 萬',
  },
  {
    n: '02',
    tag: 'SERVICE.BUILD',
    title: '客製化網站設計與開發',
    desc: '有別於大多數接案者僅會使用 WordPress 開發，我們的工程師熟練各種',
    bullets: ['RWD、SEO、深色模式、多語言... 應有盡有', '不侷限 WordPress, Vue, React,...etc 任君挑選', '完善的資安稽核包您安心'],
    price: 'NT$ 100,000',
    priceNote: '專業網站開發市價估計 30 萬起',
  },
  {
    n: '03',
    tag: 'SERVICE.STORY',
    title: '品牌故事撰寫',
    desc: '把現場聽到、看到的細節，寫成打動人的品牌文字——不是「品質優良、值得信賴」這種空話。',
    bullets: ['首頁與關於我文案', '案例故事撰寫'],
    price: 'NT$ 20,000',
    priceNote: '起 / 常見落點 2–6 萬',
  },
  {
    n: '04',
    tag: 'SERVICE.TALK',
    title: '免費需求釐清談',
    badge: '推薦入門',
    desc: '還不確定要不要做網站？先聊聊，我會老實告訴你適不適合找我。',
    bullets: ['30 分鐘線上通話', '書面建議（委託後全額折抵）'],
    price: '免費',
    priceNote: '委託後全額折抵',
  },
];

const reasons = [
  { n: '00', tag: '// PACE.SLOW', title: '慢下來的節奏', desc: '不是效率最高，但看得懂你說不出口的需求。' },
  { n: '01', tag: '// ONSITE.REAL', title: '真的會到現場', desc: '不是線上問卷，是蹲點觀察與面對面訪談。' },
  {
    n: '02',
    tag: '// STORY.HONEST',
    title: '案例寫真實細節',
    desc: '不寫「客戶很滿意」這種空話，每篇案例都有背景、觀察、決策、結果。',
  },
  { n: '03', tag: '// CRAFT.ONE', title: '設計與文字同一人做', desc: '網站視覺跟品牌文案由同一個人完成，調性不會分裂。' },
];

const steps = [
  { n: '01', time: '30分鐘~2小時', title: '線上訪談' },
  { n: '02', time: '1 天+', title: '現場實際考察' },
  { n: '03', time: '1–2 週', title: '設計提案' },
  { n: '04', time: '2–4 週', title: '開發製作' },
  { n: '05', time: '上線後', title: '產品交付與後續維護' },
];
---

<BaseLayout title="昱感網頁美學 — 軟體工程師">
  {/*
    英雄圖：兩張蝸牛提供的剪紙插畫疊在同一個位置，靠 dark:hidden／dark:block
    切換顯示哪一張——淺色模式看日景、深色模式看夜景，不用 JS 判斷，純 CSS。
    原圖左上角燒進去的「CITY OF LIGHT」英文標題已經用 Pillow 蓋掉了，
    現在的標題文字是下面那塊獨立的面板，不是圖片的一部分。
  */}
  <section class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-border shadow-sm sm:aspect-[16/9]">
    <img
      src="/images/hero-day.webp"
      alt="剪紙風格的台北城市插畫，彩虹跨過台北101"
      class="absolute inset-0 h-full w-full object-cover object-left dark:hidden"
    />
    <img
      src="/images/hero-night.webp"
      alt="剪紙風格的台北城市夜景插畫，滿月高掛台北101上方"
      class="absolute inset-0 hidden h-full w-full object-cover object-left dark:block"
    />

    {/*
      三朵雲手動排位置（top/left 百分比），各自用 --cloud-from-x／--cloud-from-y
      指定從哪個方向飄進來、--cloud-delay 讓三朵不要同時飄入。
      這些位置是配合英雄圖裡插畫的山巒／天空手動調出來的，換了別張圖
      大概率要重新調整。
    */}
    <Cloud
      class="absolute top-[6%] left-[46%] w-16 sm:w-24"
      style="--cloud-from-x:-28px; --cloud-from-y:-14px; --cloud-delay:80ms;"
    />
    <Cloud
      class="absolute top-[18%] left-[68%] w-20 sm:w-28"
      style="--cloud-from-x:30px; --cloud-from-y:-10px; --cloud-delay:280ms;"
    />
    <Cloud
      class="absolute top-[8%] right-[4%] w-24 sm:w-32"
      style="--cloud-from-x:40px; --cloud-from-y:-14px; --cloud-delay:460ms;"
    />

    {/*
      定位／尺寸是拿實際插畫的留白區域量出來的，不是隨便給的數字：
      把英雄圖用 object-fit:cover 的邏輯換算成桌機／手機兩種容器尺寸下
      實際看到的裁切範圍，再用程式逐行掃描找出留白紙面跟畫面主體
      （彩虹／101／山巒）的邊界，取「從左上角能放進去的最大矩形」，
      卡片就設成這個尺寸——盡量貼滿留白，同時不壓到畫面主體。
      換掉英雄圖或大幅調整版面寬度時，這組數字要重新核對。
      z-10：只需要蓋過英雄圖跟雲朵，不需要蓋過導覽列——導覽列是 z-20
      （見 Header.astro 的說明），這樣捲動時導覽列才會一直保持在最上層。
    */}
    <div
      class="slide-in-left absolute top-0 left-0 z-10 flex h-[460px] w-[350px] flex-col justify-center gap-2.5 rounded-tl-2xl rounded-br-2xl border border-border bg-card/95 p-4 shadow-lg backdrop-blur-sm sm:top-0 sm:left-0 sm:h-[375px] sm:w-[325px] sm:gap-4 sm:p-6"
    >
      <p class="text-xs font-medium tracking-wide text-accent sm:text-sm">昱感網頁設計</p>
      <h1 class="font-serif text-xl leading-tight font-semibold text-foreground sm:text-3xl">
        你好，世界
      </h1>
      <p class="text-xs text-muted sm:text-base">
        2026 年，AI 能在三分鐘生出一個網站。我選擇不那麼快——花時間走進你的現場，把說不出口的需求聽懂。
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a
          href="/portfolio"
          class="rounded-md bg-accent px-3 py-1.5 text-xs font-semibold text-accent-foreground transition-opacity hover:opacity-90 sm:px-4 sm:py-2 sm:text-sm"
        >
          與我聯繫
        </a>
        <a
          href="/blog"
          class="rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:border-accent sm:px-4 sm:py-2 sm:text-sm"
        >
          作品集
        </a>
      </div>
      <p class="hidden text-xs text-muted sm:block">現正接案中・24 小時內回覆。</p>
    </div>
  </section>

  {/*
    跑馬燈：Array(2).fill(clientTypes).flat() 把 clientTypes 這份清單重複兩次、
    攤平成一個陣列，畫出兩份一模一樣的內容排成一長條。動畫只把整排移動
    「50%」（也就是一份的寬度，見 global.css 的 .marquee-track），
    移完剛好接上第二份，看起來像無限循環——這個技巧只重複「兩次」就夠了，
    不用真的生成無限多份。
  */}
  <div class="mt-16 overflow-hidden border-y border-border py-4">
    <div class="marquee-track flex w-max items-center gap-8 text-sm font-medium tracking-wide whitespace-nowrap text-muted">
      {Array(2)
        .fill(clientTypes)
        .flat()
        .map((type) => (
          <>
            <span>{type}</span>
            <span class="text-accent">・</span>
          </>
        ))}
    </div>
  </div>

  <section class="mt-24">
    <div class="flex items-center gap-2 text-xs font-semibold tracking-widest text-muted">
      <span>01 — SERVICES</span>
    </div>
    <div class="mt-4 max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-accent">WHAT 昱感</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
        我能提供您...
      </h2>
      <p class="mt-3 text-muted">歡迎來電洽詢，若您的產業不適合網頁設計我會直接告訴您，不讓您花一分冤枉錢。</p>
    </div>
    <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {services.map((s) => (
        <li class="rounded-xl border border-border bg-card p-6">
          <div class="flex items-center justify-between">
            <span class="font-serif text-2xl font-semibold text-accent">{s.n}</span>
            {s.badge && (
              <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">{s.badge}</span>
            )}
          </div>
          <p class="mt-3 text-xs font-medium tracking-widest text-muted">{s.tag}</p>
          <h3 class="mt-1 text-lg font-semibold text-foreground">{s.title}</h3>
          <p class="mt-2 text-sm text-muted">{s.desc}</p>
          <ul class="mt-4 flex flex-col gap-1 text-sm text-foreground">
            {s.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="text-accent">+</span>
                {b}
              </li>
            ))}
          </ul>
          <div class="mt-4 border-t border-border pt-4">
            <p class="text-lg font-semibold text-foreground">{s.price}<span class="text-xs text-muted">/起</span></p>
            <p class="text-xs text-muted">{s.priceNote}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-24">
    <div class="max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-accent">WHY 昱感</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
        為什麼選個人工作室，不選接案平台？
      </h2>
      <p class="mt-3 text-muted">因為你要的可能就在中間：比接案平台可信，比公司便宜，溝通成本是兩者之間最低的。</p>
    </div>
    <ul class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {reasons.map((r) => (
        <li>
          <div class="flex items-baseline gap-3">
            <span class="font-serif text-2xl font-semibold text-muted">{r.n}</span>
            <span class="text-xs font-medium tracking-widest text-accent">{r.tag}</span>
          </div>
          <h3 class="mt-2 text-lg font-semibold text-foreground">{r.title}</h3>
          <p class="mt-1 text-sm text-muted">{r.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-24">
    <div class="flex items-center gap-2 text-xs font-semibold tracking-widest text-muted">
      <span>02 — PROCESS</span>
    </div>
    <div class="mt-4 max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-accent">HOW 昱感</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
        你會看到我，每一步在做什麼。
      </h2>
      <p class="mt-3 text-muted">每階段都有具體交付物與決策點，不是簽完約就消失，上線才重新出現叫你驗收。</p>
    </div>
    <ol class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-5">
      {steps.map((s) => (
        <li class="border-t-2 border-accent pt-4">
          <p class="font-serif text-xl font-semibold text-foreground">{s.n}</p>
          <p class="mt-1 text-xs text-muted">{s.time}</p>
          <p class="mt-2 text-sm font-semibold text-foreground">{s.title}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-24">
    <div class="flex items-center gap-2 text-xs font-semibold tracking-widest text-muted">
      <span>03 — WORKS</span>
    </div>
    <div class="mt-4 max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-accent">WORKS / FEATURED</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">最近做的案子。</h2>
      <p class="mt-3 text-muted">每個案例都寫背景、觀察、決策、結果，不寫「客戶很滿意」這種空話。</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {cases.map((c) => (
        <a
          href={`/portfolio/${c.id}`}
          class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-colors hover:border-accent"
        >
          {/* coverImage 是 portfolio schema 的選填欄位；沒填就顯示「案場照片待補」版位，
              等蝸牛補上真實照片路徑，這裡會自動換成真圖，不用改程式碼。 */}
          {c.data.coverImage ? (
            <img src={c.data.coverImage} alt="" class="h-32 w-full rounded-lg object-cover" />
          ) : (
            <ImagePlaceholder class="h-32 w-full" />
          )}
          <span class="mt-4 w-fit rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">
            {c.data.tags[1] ?? c.data.tags[0]}
          </span>
          <h3 class="mt-3 text-base font-semibold text-foreground transition-colors group-hover:text-accent">
            {c.data.title}
          </h3>
          <p class="mt-2 flex-1 text-sm text-muted">{c.data.description}</p>
          <p class="mt-4 text-xs text-muted">{c.data.date.getFullYear()} 年</p>
        </a>
      ))}
    </div>
    <div class="mt-8">
      <a href="/portfolio" class="text-sm font-semibold text-accent hover:opacity-80">看全部案例 →</a>
    </div>
  </section>

  <section class="mt-24 rounded-2xl border border-border bg-card p-10 text-center sm:p-16">
    <p class="text-sm font-medium tracking-wide text-accent">READY WHEN YOU ARE</p>
    <h2 class="mx-auto mt-3 max-w-xl font-serif text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
      先聊聊你的案子，再決定要怎麼做。
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-muted">
      不論你是想從零做一個新網站、想把說不出口的品牌故事寫出來，或只是想知道「這樣做可不可行」——開個對話就行。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="mailto:you@example.com"
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition-opacity hover:opacity-90"
      >
        開始免費諮詢
      </a>
      <a
        href="/blog"
        class="rounded-md border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:border-accent"
      >
        看案例 →
      </a>
    </div>
  </section>
</BaseLayout>
