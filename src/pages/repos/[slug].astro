---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RepoCover from '../../components/RepoCover.astro';

export async function getStaticPaths() {
  const repos = await getCollection('repos');
  return repos.map((repo) => ({
    params: { slug: repo.id },
    props: { repo },
  }));
}

const { repo } = Astro.props;
const { Content } = await render(repo);
---

<BaseLayout title={`${repo.data.title} — 昱感網頁美學`} description={repo.data.description}>
  <article>
    {/* 回「關於我」而不是回某個專案列表頁：這些卡片只從關於我進得來，
        導覽列刻意沒有第五個分頁。 */}
    <a href="/about" class="text-sm font-medium text-accent transition-opacity hover:opacity-80">← 回關於我</a>

    <h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
      {repo.data.title}
    </h1>
    <p class="mt-3 text-base text-muted">{repo.data.description}</p>

    {repo.data.tech.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {repo.data.tech.map((item) => (
          <span class="tag-chip rounded-full px-2.5 py-1 text-xs font-medium">{item}</span>
        ))}
      </div>
    )}

    <div class="mt-10 overflow-hidden rounded-xl border border-border">
      {repo.data.coverImage ? (
        <img src={repo.data.coverImage} alt="" class="aspect-[16/9] w-full object-cover" />
      ) : (
        <RepoCover title={repo.data.title} class="aspect-[16/9] w-full" />
      )}
    </div>

    <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert prose-a:text-accent">
      <Content />
    </div>

    {/* 私有 repo 的 .md 不填 githubUrl，這顆按鈕就不會出現——填了才顯示，
        免得點過去是 404。 */}
    {repo.data.githubUrl && (
      <a
        href={repo.data.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
        </svg>
        看原始碼
      </a>
    )}
  </article>
</BaseLayout>
